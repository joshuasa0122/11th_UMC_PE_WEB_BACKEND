{
  "info": {
    "name": "UMC 8주차 - 즐겨찾기 · 영화 기록",
    "description": "0번 로그인을 먼저 보내면 accessToken이 컬렉션 변수 token에 저장되고, 나머지 요청은 Bearer {{token}}을 자동으로 사용합니다. 위에서부터 순서대로 Send 하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "0. 로그인 (토큰 자동 저장)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('로그인 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', body.result.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"noco@umc.com\",\n  \"password\": \"Noco!1234\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "1. 즐겨찾기 등록 201",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 550\n}" },
        "url": "{{baseUrl}}/favorites"
      }
    },
    {
      "name": "2. 즐겨찾기 중복 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 550\n}" },
        "url": "{{baseUrl}}/favorites"
      }
    },
    {
      "name": "3. 즐겨찾기 목록 200",
      "request": { "method": "GET", "url": "{{baseUrl}}/favorites" }
    },
    {
      "name": "4. 즐겨찾기 여부 200",
      "request": { "method": "GET", "url": "{{baseUrl}}/favorites/550" }
    },
    {
      "name": "5. 즐겨찾기 해제 200",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/favorites/550" }
    },
    {
      "name": "6. 해제 후 여부 (false)",
      "request": { "method": "GET", "url": "{{baseUrl}}/favorites/550" }
    },
    {
      "name": "7. 영화 기록 (평점 + 즐겨찾기) 201",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 238,\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화입니다.\",\n  \"addToFavorites\": true\n}" },
        "url": "{{baseUrl}}/movie-records"
      }
    },
    {
      "name": "8. 영화 기록 재요청 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 238,\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화입니다.\",\n  \"addToFavorites\": true\n}" },
        "url": "{{baseUrl}}/movie-records"
      }
    },
    {
      "name": "9. 토큰 없이 즐겨찾기 등록 401",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 550\n}" },
        "url": "{{baseUrl}}/favorites"
      }
    }
  ]
}
